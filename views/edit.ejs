<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>editing..</title>
</head>
<body>
    <h2>you're about to edit this user : <%= user.email%></h2>
    <form method="post" action="/show/<%=user.id%>?_method=PATCH">
      <textarea name="username"><%= user.username%></textarea> <br><br>
      <input type="password" name="password" placeholder="enter password"> <br><br>
      <button>Edit</button>
    </form>

  
</body>
</html>