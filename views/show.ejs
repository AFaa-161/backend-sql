<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show data</title>
    <style>
        table,tr,td{
            border: 2px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>id</th>
            <th>email</th>
            <th>username</th>
            
        </tr>
        <% for(user of users){ %>
           <tr><td><%=user.id %></td>
           <td> <%= user.username %></td>
           <td> <%= user.email %></td>
        <td><form method="get" action="/show/<%=user.id%>/edit">
             <button>EDIT USERNAME</button>
        </form></td> </tr>
       <% } %>
      
    </table>
</body>
</html>